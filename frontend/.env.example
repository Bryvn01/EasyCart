# React Configuration
DISABLE_ESLINT_PLUGIN=true
SKIP_PREFLIGHT_CHECK=true

# API Configuration
# For local development:
REACT_APP_API_URL=http://localhost:8000/api

# Image Configuration
# Base URL for backend images (e.g., uploaded product images)
REACT_APP_IMAGE_BASE_URL=http://localhost:8000

# For production on Render, set these in the Render dashboard:
# REACT_APP_API_URL=https://your-backend.onrender.com/api
# REACT_APP_IMAGE_BASE_URL=https://your-backend.onrender.com
# Example: https://easycart-backend.onrender.com/api