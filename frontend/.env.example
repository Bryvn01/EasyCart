# React Configuration
DISABLE_ESLINT_PLUGIN=true
SKIP_PREFLIGHT_CHECK=true

# API Configuration
# IMPORTANT: Node.js backend runs on port 5000 (not 8000 which is Django)
# For local development:
REACT_APP_API_URL=http://localhost:5000/api

# For production on Render, set this in the Render dashboard:
# REACT_APP_API_URL=https://your-backend.onrender.com/api
# Example: https://easycart-j6ue.onrender.com/api

# Image Configuration (optional)
# Base URL for images if using relative paths
# REACT_APP_IMAGE_BASE_URL=https://res.cloudinary.com/your-cloud-name/image/upload/