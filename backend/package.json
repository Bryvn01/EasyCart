{
  "name": "easycart-backend",
  "version": "1.0.0",
  "description": "EasyCart Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "npm install",
    "seed:kenya": "node scripts/seedKenyaProducts.js",
    "seed": "node scripts/seedProducts.js",
    "seed:idempotent": "node scripts/seedProducts.js --idempotent",
    "test": "jest tests/smoke.test.js --forceExit",
    "test:integration": "jest tests/products.test.js --forceExit",
    "test:all": "jest tests/*.test.js --forceExit"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^8.19.0",
    "multer": "^2.0.2",
    "sharp": "^0.34.4",
    "slugify": "^1.6.6",
    "socket.io": "^4.8.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "testTimeout": 30000
  },
  "engines": {
    "node": "22.x"
  }
}
