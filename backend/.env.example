###############################################
# Django Backend Environment Example (.env)    #
# Copy to .env and fill in for production!     #
###############################################

# Node.js Backend Environment Example (if using separate Node.js backend)
PORT=5000
MONGODB_URI=mongodb://localhost:27017/easycart
JWT_SECRET=your_jwt_secret
FRONTEND_URL=https://easycart-1-752r.onrender.com

# MongoDB Atlas URI for Direct PyMongo Access (Optional)
# Django 4.x uses standard ORM (SQLite/PostgreSQL/MySQL) by default
# MongoDB can be used alongside via PyMongo for specific features
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority

# Cloudinary Configuration for Image Uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SECURITY WARNING: keep the secret key used in production secret!
SECRET_KEY=replace-with-a-strong-unique-value

# SECURITY WARNING: don't run with debug turned on in production!
DEBUG=False

# Comma-separated list of allowed hosts (e.g. yourdomain.com,www.yourdomain.com)
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Database settings (PostgreSQL recommended for production, SQLite for development)
# For SQLite (default): Leave DB_ENGINE empty or set to django.db.backends.sqlite3
# For PostgreSQL: Use settings below
DB_ENGINE=django.db.backends.postgresql
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=your_db_host
DB_PORT=5432

# CORS settings (comma-separated, e.g. https://yourdomain.com,https://admin.yourdomain.com)
CORS_ALLOWED_ORIGINS=https://easycart-1-752r.onrender.com,https://admin.yourdomain.com

# Email settings (for password reset, notifications, etc.)
# Development: Use console backend (prints to console)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Production: Use SMTP backend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@easycart.com
FRONTEND_URL=http://localhost:3000

# Redis/Celery (optional, for async tasks)
REDIS_URL=redis://localhost:6379/0

# --- PRODUCTION CHECKLIST ---
# 1. Set DEBUG=False
# 2. Set a strong SECRET_KEY
# 3. Set ALLOWED_HOSTS to your real domains
# 4. Set CORS_ALLOWED_ORIGINS to your frontend domains
# 5. Configure Cloudinary credentials for image uploads
# 6. Use secure email credentials
# 7. Never commit your real .env to version control!