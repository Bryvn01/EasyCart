###############################################
# Django Backend Environment Example (.env)    #
# Copy to .env and fill in for production!     #
###############################################

# Node.js Backend Environment Example
PORT=5000
MONGODB_URI=mongodb://localhost:27017/easycart
JWT_SECRET=your_jwt_secret
FRONTEND_URL=http://localhost:3000

# SECURITY WARNING: keep the secret key used in production secret!
SECRET_KEY=replace-with-a-strong-unique-value

# SECURITY WARNING: don't run with debug turned on in production!
DEBUG=False

# Comma-separated list of allowed hosts (e.g. yourdomain.com,www.yourdomain.com)
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# MongoDB Configuration (for Django with Djongo)
# Use this for MongoDB Atlas connection
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://easycart:easycart2024@easycart.abc123.mongodb.net/?retryWrites=true&w=majority

# Database settings (fallback to SQLite/PostgreSQL if MONGO_URI not provided)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=your_db_host
DB_PORT=5432

# CORS settings (comma-separated, e.g. https://yourdomain.com,https://admin.yourdomain.com)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com

# Email settings (for password reset, notifications, etc.)
EMAIL_HOST=smtp.yourprovider.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@yourdomain.com
EMAIL_HOST_PASSWORD=your-email-password
EMAIL_USE_TLS=True

# Redis/Celery (optional, for async tasks)
REDIS_URL=redis://localhost:6379/0

# --- PRODUCTION CHECKLIST ---
# 1. Set DEBUG=False
# 2. Set a strong SECRET_KEY
# 3. Set ALLOWED_HOSTS to your real domains
# 4. Set CORS_ALLOWED_ORIGINS to your frontend domains
# 5. Use secure email credentials
# 6. Set MONGO_URI to your MongoDB Atlas connection string
# 7. Never commit your real .env to version control!