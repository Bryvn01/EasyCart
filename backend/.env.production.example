# Sentry DSN for error monitoring (get from https://sentry.io/)
SENTRY_DSN=
# Production .env template for EasyCart Django backend
# Fill in all values with your actual production secrets and settings

SECRET_KEY=<your_django_secret_key>
DEBUG=False
ALLOWED_HOSTS=easycart-backend-2k8l.onrender.com,easycart-frontend-wj9x.onrender.com,easycart-admin-dashboard.onrender.com,easycart-admin-08xf.onrender.com

DB_ENGINE=django.db.backends.postgresql
DB_NAME=easycart
DB_USER=easycart_user
DB_PASSWORD=your_production_db_password
DB_HOST=your_production_db_host
DB_PORT=5432

CLOUDINARY_API_KEY=<your_cloudinary_api_key>
CLOUDINARY_API_SECRET=<your_cloudinary_api_secret>
CLOUDINARY_CLOUD_NAME=<your_cloudinary_cloud_name>
CLOUDINARY_URL=your_cloudinary_url

CORS_ALLOWED_ORIGINS=https://easycart-frontend-wj9x.onrender.com,https://easycart-admin-dashboard.onrender.com,https://easycart-admin-08xf.onrender.com

DJANGO_SUPERUSER_EMAIL=youradmin@example.com
DJANGO_SUPERUSER_PASSWORD=YourStrongProductionPassword!
DJANGO_SUPERUSER_USERNAME=admin

# Add any other production-only settings below
