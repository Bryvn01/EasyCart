###############################################
# EasyCart Root Environment Example (.env)
# Copy to .env and fill in for production!
###############################################

# ============================================================
# DATABASE CONFIGURATION
# ============================================================
# MongoDB Atlas (Djongo) - DEFAULT for PRODUCTION
# Set this to use MongoDB Atlas with Djongo as the primary database
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
# Replace <username>, <password>, <cluster>, and <database> with your actual credentials
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# PostgreSQL/SQLite - FALLBACK for development and testing
# If MONGO_URI is not set, the app will use PostgreSQL (if DB_ENGINE is set) or SQLite (default)
# Leave MONGO_URI empty or unset to use PostgreSQL/SQLite fallback

# ============================================================
# PostgreSQL Configuration (FALLBACK - used only if MONGO_URI is not set)
# ============================================================
# Uncomment and configure these if you want to use PostgreSQL instead of MongoDB
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=<database>
# DB_USER=<username>
# DB_PASSWORD=<password>
# DB_HOST=<host>
# DB_PORT=5432

# SQLite Configuration (FALLBACK - default if neither MONGO_URI nor DB_ENGINE is set)
# No configuration needed - SQLite is used automatically for development/testing

# ============================================================
# DJANGO SETTINGS
# ============================================================
# SECURITY WARNING: keep the secret key used in production secret!
SECRET_KEY=replace-with-a-strong-unique-value

# SECURITY WARNING: don't run with debug turned on in production!
DEBUG=False

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# ============================================================
# CORS SETTINGS
# ============================================================
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# ============================================================
# EMAIL CONFIGURATION
# ============================================================
EMAIL_HOST=smtp.yourprovider.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@yourdomain.com
EMAIL_HOST_PASSWORD=your-email-password
EMAIL_USE_TLS=True

# ============================================================
# REDIS/CELERY (Optional)
# ============================================================
REDIS_URL=redis://localhost:6379/0

# --- PRODUCTION CHECKLIST ---
# 1. Set DEBUG=False
# 2. Set a strong SECRET_KEY
# 3. Configure MONGO_URI with real MongoDB Atlas credentials
# 4. Set ALLOWED_HOSTS to your real domains
# 5. Set CORS_ALLOWED_ORIGINS to your frontend domains
# 6. Never commit your real .env to version control!
