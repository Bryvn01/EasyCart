# React Configuration
DISABLE_ESLINT_PLUGIN=true
SKIP_PREFLIGHT_CHECK=true

# API Configuration
# For local development:
REACT_APP_API_URL=http://localhost:8000/api

# For production on Render, set this in the Render dashboard (or in your deployment .env file):
# REACT_APP_API_URL=https://easycart-j6ue.onrender.com/api

# Example: https://easycart-j6ue.onrender.com/api

# Image Configuration (optional)
# Base URL for images if using relative paths
# REACT_APP_IMAGE_BASE_URL=https://res.cloudinary.com/your-cloud-name/image/upload/