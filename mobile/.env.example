# API Configuration
API_BASE_URL=https://easycart-backend-2k8l.onrender.com/api
API_TIMEOUT=30000

# M-Pesa Configuration (Production Sandbox)
MPESA_SHORTCODE=174379
MPESA_PASSKEY=<your_mpesa_passkey>

# Firebase Configuration (Get from Firebase Console)
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id
FIREBASE_MEASUREMENT_ID=your-measurement-id

# Sentry Configuration (Error Monitoring)
SENTRY_DSN=your-sentry-dsn
SENTRY_ENVIRONMENT=production

# Feature Flags
ENABLE_BIOMETRIC_AUTH=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_QR_SCANNER=true
ENABLE_OFFLINE_MODE=true
ENABLE_ANALYTICS=true

# App Configuration
APP_NAME=EasyCart
APP_VERSION=1.0.0
APP_BUILD_NUMBER=1
BUNDLE_ID_ANDROID=com.easycart.app
BUNDLE_ID_IOS=com.easycart.app

# Cache Configuration
CACHE_EXPIRY_HOURS=24
MAX_CACHE_SIZE_MB=100
IMAGE_CACHE_SIZE_MB=50

# Performance
ENABLE_ANALYTICS=true
ENABLE_CRASHLYTICS=true
LOG_LEVEL=debug
